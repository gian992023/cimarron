# Copia este archivo como .env y llena los valores.
# .env está en .gitignore: nunca se sube al repositorio.

# --- Credencial de Claude (elige UNA; vive SOLO en el servidor) ---
# Opción A: API de pago por uso.
ANTHROPIC_API_KEY=
# Opción B: tu plan de Claude, $0 (el mismo patrón de NEXO).
#   Genera el token una vez con:   claude setup-token
#   y pégalo aquí. Si pones este, deja ANTHROPIC_API_KEY vacío.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Modelo (opcional, ya tiene valores por defecto) ---
# claude-sonnet-5 = el más barato de la familia 5 ($2/$10 por 1M tok): máximo ahorro.
# Sube a claude-opus-5 solo si necesitas más razonamiento en el pitch.
CIMARRON_MODELO=claude-sonnet-5
# low | medium | high | xhigh | max  → medium mantiene el chat rápido en la demo
CIMARRON_ESFUERZO=medium

# --- Pago Bre-B (lo entrega Gian) ---
# La llave Bre-B a la que llega la plata (arroba, celular o correo registrado)
BREB_LLAVE=@cimarron
# Nombre que ve el comprador al escanear
BREB_TITULAR=CIMARRON
# Ruta pública del QR estático de la llave. El archivo va en assets/qr-breb.png
BREB_QR_URL=/assets/qr-breb.png
# WhatsApp de soporte humano (solo dígitos, con indicativo 57)
WHATSAPP_SOPORTE=573001234567

# --- Origen de datos ---
# memoria  = demo garantizada, sin dependencias externas (por defecto)
# supabase = producción
CIMARRON_ORIGEN_DATOS=memoria

# --- Supabase (solo si CIMARRON_ORIGEN_DATOS=supabase) ---
# Ver supabase/README.md para los pasos de conexión.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Servidor ---
PUERTO=8787
